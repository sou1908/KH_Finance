# Server settings. On Hostinger these go in the deployment's
# "Environment variables" panel, NOT in a file — a file would be replaced on
# every deploy and would put your database password in git.
#
# Copy this to .env only for running locally.

# --- database -----------------------------------------------------------
# 127.0.0.1, never "localhost". MariaDB treats user@localhost, user@127.0.0.1
# and user@::1 as three separate accounts and grants you one of them; on modern
# systems "localhost" resolves to IPv6 ::1, which matches no grant. The failure
# is ER_ACCESS_DENIED_ERROR — identical to a wrong password, with a password
# that is completely correct.
#
# To be certain, run in phpMyAdmin:  SHOW GRANTS FOR CURRENT_USER();
# whatever follows the @ is the only host that will work.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Use the FULL prefixed names Hostinger gives you.
MYSQL_DATABASE=u123456789_kalope
MYSQL_USER=u123456789_kalope
# Letters and numbers only — symbols occasionally get mangled passing through
# hosting panels, and that is not a problem worth an afternoon.
MYSQL_PASSWORD=

# --- the first login ----------------------------------------------------
# Created once, on the first boot, only while no user exists. Without these the
# app starts cleanly and nobody can sign in. Changing the password here later
# does NOT reset an account you have already changed inside the app.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# --- uploads ------------------------------------------------------------
# MUST be outside the deployed folder. A deploy replaces the application
# directory, and bill photos are gitignored — correctly, they hold customer
# material — so they are not restored by it. Left inside, every deploy silently
# destroys every photo. Substitute your real account id.
UPLOAD_DIR=/home/u123456789/kalope-uploads

# --- optional -----------------------------------------------------------
# PORT is assigned by the host. Never hardcode it in the panel.
# Only needed if the app is served from a different origin than this server.
# ALLOWED_ORIGINS=http://localhost:5173
# SESSION_DAYS=30
# MAX_UPLOAD_BYTES=12582912

# --- frontend -----------------------------------------------------------
# Not needed in production: the server that serves the app also answers /api,
# so the browser talks to its own origin. Set this only to point a separately
# hosted frontend at a different API.
# VITE_API_URL=https://yourdomain.com/api
